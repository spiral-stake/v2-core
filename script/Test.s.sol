pragma solidity 0.8.30;

import {Script} from "forge-std/Script.sol";
import {IERC20Metadata} from "@openzeppelin/contracts/interfaces/IERC20Metadata.sol";
import {IERC20} from "@openzeppelin/contracts/interfaces/IERC20.sol";
import {MockV3Aggregator} from "@chainlink/contracts/src/v0.8/shared/mocks/MockV3Aggregator.sol";
import {ERC20Mock} from "../src/mocks/ERC20Mock.sol";
import {IERC20Mock} from "../src/interfaces/IERC20Mock.sol";
import {DeployStblUSD, PositionManager} from "../script/DeployStblUSD.s.sol";
import {AggregatorV3Interface} from "@chainlink/contracts/src/v0.8/shared/interfaces/AggregatorV3Interface.sol";
import {FlashLeverageCore} from "../src/core/leverage/FlashLeverageCore.sol";
import {FlashLeverage, CollateralTokenData, LeverageParams, LeveragePosition, ApproxParams, SwapData, SwapParams, LimitOrderData} from "../src/core/leverage/FlashLeverage.sol";
import {SwapAggregator, IPAllActionV3, SwapType} from "../src/core/leverage/SwapAggregator.sol";
import {IWETH} from "../src/interfaces/IWETH.sol";
import {CollateralTokenConfig} from "../src/core/structs/CollateralTokenConfig.sol";
import {DeployFlashLeverageCore} from "./DeployFlashLeverageCore.s.sol";

import {console} from "forge-std/console.sol";

contract Test is Script, SwapAggregator {
    address pendleRouter = 0x888888888889758F76e7103c6CbF23ABbF58F946;
    address morpho = 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb;
    address oracleRouter = 0xAdD7d4b72A2218541A16f720B3Ab8a604880AC38;
    uint256 amountUserCollateralCap = 105e18; // 105
    bytes32 ptUSRMorphoMarketId =
        0x669b68ae003954dde5b2be025fa373bfc6b6134fc3180ea746c31e892243ae81;

    address WETH = 0x4200000000000000000000000000000000000006;
    address PTUSR = 0xa6F0A4D18B6f6DdD408936e81b7b3A8BEFA18e77;
    address USR = 0x35E5dB674D8e93a03d814FA0ADa70731efe8a4b9;
    address USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;

    address PT_USR_WHALE = 0x2aC1d4ED5F6c0F20FFA29571910753e4Cc941BB5;
    address payable myAddress =
        payable(0x08675879B01177a9Bc80A7FC58c032cFA2Bb7742);

    constructor() SwapAggregator(pendleRouter) {}

    function run() external {
        address flashLeverageAddress = _setup();
        // _prank(flashLeverageAddress);
    }

    function _setup() internal returns (address) {
        CollateralTokenConfig[] memory configs = new CollateralTokenConfig[](1);
        configs[0] = CollateralTokenConfig({
            collateralToken: PTUSR,
            loanToken: USDC,
            morphoMarketId: ptUSRMorphoMarketId,
            underlyingToken: USR,
            pendleMarket: 0x715509Bde846104cF2cCeBF6fdF7eF1BB874Bc45
        });

        FlashLeverageCore flashLeverageCore = FlashLeverageCore(
            new DeployFlashLeverageCore().run(
                morpho,
                pendleRouter,
                oracleRouter,
                amountUserCollateralCap,
                configs
            )
        );

        vm.startBroadcast();

        FlashLeverage flashLeverage = new FlashLeverage(
            address(flashLeverageCore),
            pendleRouter
        );

        flashLeverageCore.setManager(address(flashLeverage), true);
        flashLeverage.addCollateralToken(
            configs[0].collateralToken,
            CollateralTokenData({
                pendleMarket: configs[0].pendleMarket,
                underlyingToken: configs[0].underlyingToken
            })
        );

        vm.stopBroadcast();

        if (block.chainid == 31337) {
            vm.startBroadcast();

            // SENDING ETH
            myAddress.transfer(11 ether);
            // SENDING PT-USR
            address pendleSwap = 0xd4F480965D2347d421F1bEC7F545682E5Ec2151D;
            uint256 amountWeth = 10e18;
            IWETH(WETH).deposit{value: amountWeth}();
            IERC20(WETH).approve(pendleRouter, amountWeth);
            IPAllActionV3(pendleRouter).swapExactTokenForPt(
                myAddress,
                configs[0].pendleMarket,
                0,
                _createDefaultApproxParams(),
                _createTokenInputSimple(
                    WETH,
                    amountWeth,
                    USR,
                    pendleSwap,
                    SwapData(
                        SwapType(1),
                        0x6131B5fae19EA4f9D964eAc0408E4408b66337b5,
                        hex"",
                        false
                    )
                ),
                _createEmptyLimitOrderData()
            );
            vm.stopBroadcast();
        }

        console.log(address(flashLeverageCore));
        console.log(address(flashLeverage));

        return address(flashLeverage);
    }

    function _prank(address flashLeverageAddress) internal {
        uint256 amountCollateral = 12000000000000000000;

        vm.startPrank(PT_USR_WHALE);
        FlashLeverage flashLeverage = FlashLeverage(flashLeverageAddress);

        IERC20(PTUSR).approve(flashLeverageAddress, amountCollateral);
        flashLeverage.leverage(
            PT_USR_WHALE,
            LeverageParams(
                PTUSR,
                USDC,
                amountCollateral,
                ApproxParams({
                    guessMin: 38912042436116124543,
                    guessMax: 81715289115843861541,
                    guessOffchain: 77824084872232249087,
                    maxIteration: 30,
                    eps: 10000000000000
                }),
                0xd4F480965D2347d421F1bEC7F545682E5Ec2151D,
                SwapData({
                    swapType: SwapType(1),
                    extRouter: 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5,
                    extCalldata: hex"",
                    needScale: false
                }),
                _createEmptyLimitOrderData()
            )
        );

        vm.stopPrank();
    }
}
