import {AggregatorV3Interface} from "@chainlink/contracts/src/v0.8/shared/interfaces/AggregatorV3Interface.sol";
import {BorrowSwapper} from "../src/routers/BorrowSwapper.sol";
import {LeverageWrapper} from "../src/routers/LeverageWrapper.sol";
import {FlashLeverage, MarketParams, ApproxParams, SwapData, PendleParams, SwapType, IPAllActionV3, SwapAggregator} from "../src/core/leverage/FlashLeverage.sol";
import {IWETH} from "../src/interfaces/IWETH.sol";

import {console} from "forge-std/console.sol";

contract Test is Script, SwapAggregator {
    function run() external returns (address) {
        address PT_USR_WHALE = 0x2aC1d4ED5F6c0F20FFA29571910753e4Cc941BB5;
        address WETH = 0x4200000000000000000000000000000000000006;
        address PTUSR = 0xa6F0A4D18B6f6DdD408936e81b7b3A8BEFA18e77;
        address USR = 0x35E5dB674D8e93a03d814FA0ADa70731efe8a4b9;
        address USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
        bytes32 ptUSRMorphoMarketId = 0x669b68ae003954dde5b2be025fa373bfc6b6134fc3180ea746c31e892243ae81;
        address morpho = 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb;
        address pendleRouter = 0x888888888889758F76e7103c6CbF23ABbF58F946;

        address payable myAddress = payable(
            0x08675879B01177a9Bc80A7FC58c032cFA2Bb7742
        );

        vm.startBroadcast();

        FlashLeverage flashLeverage = new FlashLeverage(
            morpho,
            pendleRouter,
            0xAdD7d4b72A2218541A16f720B3Ab8a604880AC38
        );

        PendleParams[] memory pendleParams = new PendleParams[](1);
        pendleParams[0] = PendleParams({
            underlyingToken: 0x35E5dB674D8e93a03d814FA0ADa70731efe8a4b9,
            market: 0x715509Bde846104cF2cCeBF6fdF7eF1BB874Bc45
        });

        flashLeverage.addSupportedCollateralToken(
            PTUSR,
            ptUSRMorphoMarketId,
            pendleParams[0]
        );

        // SENDING ETH
        myAddress.transfer(250 ether);

        // SENDING PT-USR
        address pendleSwap = 0xd4F480965D2347d421F1bEC7F545682E5Ec2151D;
        uint256 amountWeth = 10e18;
        IWETH(WETH).deposit{value: amountWeth}();

        IERC20(WETH).approve(pendleRouter, amountWeth);
        console.log(
            IERC20(WETH).allowance(
                0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266,
                pendleSwap
            )
        );
        IPAllActionV3(pendleRouter).swapExactTokenForPt(
            myAddress,
            pendleParams[0].market,
            0,
            createDefaultApproxParams(),
            createTokenInputSimple(
                WETH,
                amountWeth,
                USR,
                pendleSwap,
                SwapData(
                    SwapType(6),
                    0x6A000F20005980200259B80c5102003040001068,
                    hex"",
                    false
                )
            ),
            createEmptyLimitOrderData()
        );

        console.log(IERC20(PTUSR).balanceOf(myAddress));

        vm.stopBroadcast();

        // Prank

        vm.startPrank(PT_USR_WHALE);

        uint256 amountCollateral = 1000e18;
        uint256 ltv = 80e16;

        IERC20(PTUSR).approve(address(flashLeverage), amountCollateral);

        flashLeverage.leverage(
            myAddress,
            PTUSR,
            amountCollateral,
            ltv,
            ApproxParams(
                1992098961358299349080,
                4183407818852428633069,
                3984197922716598698161,
                30,
                10000000000000
            ),
            0xd4F480965D2347d421F1bEC7F545682E5Ec2151D,
            SwapData(
                SwapType(1),
                0x6131B5fae19EA4f9D964eAc0408E4408b66337b5,
                hex"",
                false
            )
        );

        vm.stopPrank();

        return address(flashLeverage);
    }
}
